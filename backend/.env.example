# Server
PORT=5000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
INTERNAL_SERVICE_TOKEN=dev-internal-service-token

# Service URLs
AUTH_SERVICE_URL=http://localhost:5101
USER_SERVICE_URL=http://localhost:5102
EXTINGUISHER_SERVICE_URL=http://localhost:5103
INSPECTION_MAINTENANCE_SERVICE_URL=http://localhost:5104
REPORTING_SERVICE_URL=http://localhost:5105
NOTIFICATION_SERVICE_URL=http://localhost:5106

# Service Ports
AUTH_SERVICE_PORT=5101
USER_SERVICE_PORT=5102
EXTINGUISHER_SERVICE_PORT=5103
INSPECTION_MAINTENANCE_SERVICE_PORT=5104
REPORTING_SERVICE_PORT=5105
NOTIFICATION_SERVICE_PORT=5106

# PostgreSQL
DB_HOST=localhost
DB_USER=postgres
DB_PASS=yourpassword
DB_NAME=tzw_fire_safety_db
AUTH_DB_NAME=tzw_auth_db
USER_DB_NAME=tzw_user_db
EXTINGUISHER_DB_NAME=tzw_extinguisher_db
INSPECTION_MAINTENANCE_DB_NAME=tzw_inspection_maintenance_db
REPORTING_DB_NAME=tzw_reporting_db
NOTIFICATION_DB_NAME=tzw_notification_db

# JWT
JWT_SECRET=supersecretkey123
JWT_EXPIRES_IN=24h

# Email notifications (Gmail SMTP app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_TIMEOUT_MS=10000
SMTP_USER=christiantc0000@gmail.com
SMTP_PASS=your-gmail-app-password
NOTIFICATION_DEFAULT_RECIPIENT=christiantc0000@gmail.com

# RabbitMQ event streaming
RABBITMQ_URL=amqp://localhost
RABBITMQ_EXCHANGE=tzw.domain.events
NOTIFICATION_QUEUE=notification.email
NOTIFICATION_QUEUE_PREFETCH=5
