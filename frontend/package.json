{
  "name": "restful-template-frontend",
  "version": "1.0.0",
  "description": "TypeScript React frontend for TZW LTD fire extinguisher operations with Mantine UI, Axios, protected routes, OTP signup, extinguisher CRUD, inspections, maintenance, reports, and RBAC screens.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000"
  },
  "dependencies": {
    "@mantine/core": "^9.2.2",
    "@mantine/form": "^9.2.2",
    "@mantine/hooks": "^9.2.2",
    "@mantine/notifications": "^9.2.2",
    "@tabler/icons-react": "^3.44.0",
    "axios": "^1.7.9",
    "jwt-decode": "^4.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^6.28.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^6.0.3",
    "vite": "^6.0.3"
  },
  "engines": {
    "node": ">=18"
  }
}
